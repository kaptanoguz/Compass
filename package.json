{
  "name": "compass",
  "productName": "Compass",
  "version": "1.0.0",
  "description": "Türkçe torrent arama. İndirmeyi qBittorrent yapar; varsayılan kaynak Internet Archive.",
  "type": "module",
  "main": "electron/main.js",
  "desktopName": "compass.desktop",
  "license": "MIT",
  "author": "kaptanoguz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaptanoguz/torrent.git"
  },
  "homepage": "https://github.com/kaptanoguz/torrent#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron . --class=compass",
    "web": "node bin/web.js",
    "kisayol": "node bin/kisayol.js",
    "test": "node --test --test-force-exit",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "parse-torrent": "^11.0.24"
  },
  "devDependencies": {
    "create-torrent": "^6.1.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.kaptanoguz.compass",
    "productName": "Compass",
    "files": [
      "electron/**",
      "src/**",
      "public/**",
      "bin/**",
      "package.json"
    ],
    "icon": "build/icon.png",
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "maintainer": "kaptanoguz",
      "target": ["AppImage", "deb"],
      "category": "Network",
      "synopsis": "Search, download, and play. qBittorrent does the transfer.",
      "executableName": "compass",
      "syncDesktopName": true
    }
  }
}
